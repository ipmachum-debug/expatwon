---
import type { CollectionEntry } from 'astro:content';

import AdSlot from '../components/AdSlot.astro';
import FormattedDate from '../components/FormattedDate.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SourcesFooter from '../components/SourcesFooter.astro';
import { getCategory } from '../lib/categories';
import { SITE_TITLE, SITE_URL } from '../lib/site';
import Layout from './Layout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const {
  title,
  description,
  publishDate,
  updatedDate,
  sources,
  affiliate,
  faq,
  keyFacts,
  revisions,
} = post.data;
const category = getCategory(post.data.category);
const canonical = `${SITE_URL}/${category.slug}/${post.id}/`;

// Mid-article ad only for long-form posts (site policy: 800+ words).
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const showMidAd = wordCount >= 800;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Person',
    name: 'Michael Han',
    url: `${SITE_URL}/about/#author`,
    jobTitle: 'Founder & CEO, Danji Co., Ltd.',
    image: `${SITE_URL}/author.jpg`,
    description:
      'Korean manufacturing-company CEO since 2016; Managing Director, VSL Vietnam; certified ISO 9001/14001/45001 lead auditor (KOCI).',
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: SITE_URL,
  },
};

const faqSchema =
  faq && faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;
---

<Layout title={title} description={description} article>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {
      faqSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      )
    }
  </Fragment>

  <article class="mx-auto max-w-3xl">
    <nav class="mb-5 text-sm text-slate-400">
      <a href="/" class="hover:text-ink">Home</a>
      <span class="mx-1.5">/</span>
      <a href={`/${category.slug}/`} class="hover:text-ink">{category.shortTitle}</a>
    </nav>

    <header class="mb-8">
      <span class={`mb-4 inline-block rounded-full px-2.5 py-1 text-[0.7rem] font-semibold tracking-wider uppercase ${category.chip}`}>
        {category.shortTitle}
      </span>
      <h1 class="mb-4 font-display text-[2.5rem] leading-[1.15] font-bold text-ink sm:text-[2.9rem]">
        {title}
      </h1>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-400">
        <span>Published <FormattedDate date={publishDate} /></span>
        <a href="#revisions" class="flex items-center gap-1.5 font-medium text-blue-600 hover:text-accent-dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
            <circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" />
          </svg>
          Last verified <FormattedDate date={updatedDate} />
        </a>
      </p>
    </header>

    {
      keyFacts && keyFacts.length > 0 && (
        <div class="mb-8 flex flex-wrap gap-3">
          {keyFacts.map((fact) => (
            <div class="min-w-[140px] flex-1 rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3">
              <div class="text-[0.68rem] font-semibold tracking-wider text-slate-400 uppercase">
                {fact.label}
              </div>
              <div class="mt-0.5 text-[0.95rem] font-semibold text-ink">
                {fact.value}
              </div>
            </div>
          ))}
        </div>
      )
    }

    <AdSlot position="top" />

    <div class="prose-article">
      <slot />
    </div>

    {showMidAd && <AdSlot position="mid" />}

    {
      faq && faq.length > 0 && (
        <section class="mt-12">
          <h2 class="mb-5 font-display text-[1.75rem] font-semibold text-ink">
            Frequently asked questions
          </h2>
          <dl class="space-y-4">
            {faq.map((item) => (
              <div class="rounded-2xl border border-slate-200 bg-white p-5">
                <dt class="mb-1.5 font-semibold text-ink">{item.question}</dt>
                <dd class="text-[0.95rem] leading-relaxed text-slate-500">{item.answer}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <aside class="mt-12 flex gap-4 rounded-2xl border border-slate-200 bg-slate-50/60 p-5">
      <picture class="flex-none">
        <source srcset="/author.webp" type="image/webp" />
        <img
          src="/author.jpg"
          alt="Michael Han"
          width="320"
          height="320"
          loading="lazy"
          decoding="async"
          class="h-14 w-14 rounded-full object-cover ring-1 ring-slate-200"
        />
      </picture>
      <div class="text-sm leading-relaxed text-slate-500">
        <p class="mb-0.5 font-semibold text-ink">Written by Michael Han</p>
        <p>
          Founder &amp; CEO of a Korean manufacturing company since 2016 ·
          Managing Director, VSL Vietnam · Certified ISO 9001 / 14001 / 45001
          lead auditor.&nbsp;
          <a
            href="/about/#author"
            class="font-medium text-accent-dark underline decoration-blue-300 underline-offset-[3px] hover:decoration-blue-600"
          >About the author</a>
        </p>
      </div>
    </aside>

    <SourcesFooter
      updatedDate={updatedDate}
      sources={sources}
      affiliate={affiliate}
      revisions={revisions}
      publishDate={publishDate}
    />

    <RelatedPosts category={category.slug} excludeId={post.id} />

    <AdSlot position="bottom" />
  </article>
</Layout>
