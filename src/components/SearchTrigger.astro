---
/**
 * Opens the search dialog. Wide screens only — phones get the real input that
 * SiteSearch renders inline in the header, because a modal over a blurred page
 * with the keyboard up is the wrong shape on a small screen.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  type="button"
  data-search-open
  class:list={[
    'items-center gap-2 rounded-full border border-rule bg-paper-deep/50 px-3 py-1.5 font-sans text-[0.82rem] text-ink-soft/70 transition-colors hover:border-ink-soft/30 hover:text-ink',
    className,
  ]}
  aria-label="Search this site"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-3.5 w-3.5">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  Search
  <kbd data-search-hint class="font-sans text-[0.72rem] tracking-wide text-ink-soft/45">Ctrl K</kbd>
</button>
