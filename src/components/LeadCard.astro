---
import type { CollectionEntry } from 'astro:content';

import { categoryVars, getCategory } from '../lib/categories';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const category = getCategory(post.data.category);
const facts = post.data.keyFacts?.slice(0, 3) ?? [];
---

<article
  class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border p-7 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60 sm:p-9"
  style={`${categoryVars(category)};border-color:var(--cat-line);background:var(--cat-tint)`}
>
  <span
    class="pointer-events-none absolute -right-8 -bottom-14 hidden h-52 w-52 rounded-full opacity-[0.13] sm:block"
    style="background:var(--cat-accent)"
    aria-hidden="true"></span>

  <div class="relative">
    <p class="mb-4 flex items-center gap-2.5 text-[0.7rem] font-semibold tracking-wider uppercase" style="color:var(--cat-ink)">
      <span class="inline-block h-2 w-2 rounded-full" style="background:var(--cat-accent)"></span>
      Latest · {category.shortTitle}
    </p>
    <h3 class="mb-3 max-w-2xl font-display text-[1.9rem] leading-[1.15] font-bold text-ink sm:text-[2.3rem]">
      <a href={`/${category.slug}/${post.id}/`} class="after:absolute after:inset-0">
        {post.data.title}
      </a>
    </h3>
    <p class="mb-6 max-w-2xl text-[1.02rem] leading-relaxed text-slate-600">
      {post.data.description}
    </p>
  </div>

  <div class="relative">
    {
      facts.length > 0 && (
        <dl class="mb-5 flex flex-wrap gap-x-8 gap-y-3 border-t pt-5" style="border-color:var(--cat-line)">
          {facts.map((fact) => (
            <div>
              <dt class="text-[0.68rem] font-semibold tracking-wider uppercase" style="color:var(--cat-ink)">
                {fact.label}
              </dt>
              <dd class="mt-0.5 text-[0.98rem] font-semibold text-ink">{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <p class="flex items-center gap-2 text-xs text-slate-500">
      <span>Updated <FormattedDate date={post.data.updatedDate} /></span>
      <span class="transition-transform group-hover:translate-x-0.5" style="color:var(--cat-accent)" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </span>
    </p>
  </div>
</article>
