---
import { getCollection } from 'astro:content';

import { getCategory } from '../lib/categories';

interface Props {
  category: string;
  /** post id to exclude (the post being viewed), if any */
  excludeId?: string;
  heading?: string;
}

const { category, excludeId, heading = 'Related guides' } = Astro.props;
const categoryMeta = getCategory(category);

const related = (
  await getCollection(
    'posts',
    (p) => p.data.category === category && !p.data.draft && p.id !== excludeId,
  )
)
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf())
  .slice(0, 5);
---

{
  related.length > 0 && (
    <section class="mt-12 rounded-2xl bg-paper p-6 sm:p-7">
      <h2 class="mb-4 font-display text-xl font-semibold text-ink">{heading}</h2>
      <ul class="space-y-3">
        {related.map((p) => (
          <li>
            <a
              href={`/${categoryMeta.slug}/${p.id}/`}
              class="group flex items-baseline gap-2.5 text-[0.95rem] font-medium text-slate-600 transition-colors hover:text-accent-dark"
            >
              <span class="text-emerald-400 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                →
              </span>
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
