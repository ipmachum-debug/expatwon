---
/**
 * The live figures a guide rests on, resolved from the observation database
 * rather than restated here. When a rate moves, one JSON file changes and
 * every guide showing this block is correct again — which is the whole reason
 * the history lives outside the manuscript.
 */
import { getSeries, hasHistory, latest } from '../data/observations';

interface Props {
  tracked?: string[];
  lastVerified?: Date;
}

const { tracked = [], lastVerified } = Astro.props;

const rows = tracked
  .map((key) => getSeries(key))
  .filter((s): s is NonNullable<typeof s> => Boolean(s))
  .map((series) => ({ series, now: latest(series), moved: hasHistory(series) }));

const verified = lastVerified
  ? lastVerified.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
---

{
  rows.length > 0 && (
    <section class="mt-12 border-t-2 border-[var(--cat-accent)] pt-5">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="font-display text-lg font-semibold text-ink">Figures in this guide we track</h2>
        {verified && (
          <span class="font-mono text-[0.7rem] tracking-wide text-ink-soft/60 uppercase">
            Last checked {verified}
          </span>
        )}
      </div>

      <ul class="divide-y divide-rule border-y border-rule">
        {rows.map(({ series, now, moved }) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
            <a
              href={`/tracked/${series.key}/`}
              class="font-sans text-[0.95rem] font-medium text-ink transition-colors hover:text-gold"
            >
              {series.label}
            </a>
            <span class="flex items-baseline gap-3">
              <span class="font-mono text-[0.95rem] font-semibold text-ink tabular-nums">
                {now.display}
              </span>
              <span class="font-mono text-[0.68rem] tracking-wide text-ink-soft/55 uppercase">
                {moved ? `since ${now.date}` : now.date}
              </span>
            </span>
          </li>
        ))}
      </ul>

      <p class="mt-3 font-sans text-[0.82rem] leading-relaxed text-ink-soft/65">
        These move. We check them on a schedule and keep the previous values, so
        you can see what a figure was, not only what it is.
      </p>
    </section>
  )
}
