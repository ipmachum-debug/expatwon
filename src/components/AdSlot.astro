---
/**
 * AdSense slot. Hidden until approval — an empty "advertisement" box reads
 * as an unfinished site to AdSense reviewers. After approval, replace this
 * markup with the ad unit code per position. Max 3 slots per page (site
 * policy); the mid slot only renders on 800+ word posts (PostLayout).
 */
interface Props {
  position: 'top' | 'mid' | 'bottom';
}

const { position } = Astro.props;
---

<div class="ad-slot" data-ad-position={position} hidden></div>
