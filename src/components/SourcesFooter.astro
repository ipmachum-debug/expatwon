---
/**
 * Auto-appended to every post: last-verified date, official sources,
 * affiliate disclosure (when applicable), and the standing disclaimer.
 */
import FormattedDate from './FormattedDate.astro';

interface Props {
  updatedDate: Date;
  sources: { label: string; url: string }[];
  affiliate: boolean;
  revisions?: { date: Date; change: string; source?: string }[];
  publishDate: Date;
}

const { updatedDate, sources, affiliate, revisions, publishDate } = Astro.props;

// Newest first; every post shows at least its publication entry.
const history = [...(revisions ?? [])].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf(),
);
const hasPublishEntry = history.some(
  (r) => r.date.valueOf() === publishDate.valueOf(),
);
---

<section class="mt-12 rounded-2xl border border-rule bg-white p-6 text-sm sm:p-7">
  <p class="mb-5 flex items-center gap-2 font-semibold text-ink">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-blue-500">
      <circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" />
    </svg>
    Last verified: <FormattedDate date={updatedDate} />
  </p>

  <h2 class="mb-3 text-xs font-semibold tracking-widest text-ink-soft/65 uppercase">Official sources</h2>
  <ul class="mb-5 space-y-2">
    {
      sources.map((s) => (
        <li class="flex items-baseline gap-2">
          <span class="text-blue-400" aria-hidden="true">↗</span>
          <a
            href={s.url}
            rel="noopener nofollow"
            target="_blank"
            class="font-medium text-slate-600 underline decoration-slate-300 underline-offset-[3px] hover:text-gold hover:decoration-blue-400"
          >
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>

  <h2 id="revisions" class="mb-3 scroll-mt-24 text-xs font-semibold tracking-widest text-ink-soft/65 uppercase">
    Revision history
  </h2>
  <ol class="mb-5 space-y-2.5 border-l border-rule pl-4">
    {
      history.map((r) => (
        <li class="relative">
          <span class="absolute top-[0.45rem] -left-[1.3rem] h-1.5 w-1.5 rounded-full bg-blue-300" aria-hidden="true" />
          <span class="block text-xs font-semibold text-ink-soft/85">
            <FormattedDate date={r.date} />
          </span>
          <span class="block text-[0.85rem] leading-relaxed text-ink-soft/85">
            {r.change}
            {r.source && (
              <a
                href={r.source}
                rel="noopener nofollow"
                target="_blank"
                class="ml-1.5 text-blue-500 underline decoration-blue-200 underline-offset-2 hover:decoration-blue-400"
              >
                source
              </a>
            )}
          </span>
        </li>
      ))
    }
    {
      !hasPublishEntry && (
        <li class="relative">
          <span class="absolute top-[0.45rem] -left-[1.3rem] h-1.5 w-1.5 rounded-full bg-slate-300" aria-hidden="true" />
          <span class="block text-xs font-semibold text-ink-soft/85">
            <FormattedDate date={publishDate} />
          </span>
          <span class="block text-[0.85rem] text-ink-soft/85">Published</span>
        </li>
      )
    }
  </ol>

  <p class="mb-5 text-xs leading-relaxed text-ink-soft/65">
    Figures here are re-checked against their official sources at least every
    six months. Substantive changes — a rate, a cap, a rule — are logged above
    rather than silently overwritten, and collected site-wide in
    <a href="/updates/" class="text-ink-soft/85 underline decoration-slate-300 underline-offset-2 hover:text-gold">
      updates &amp; revisions</a>.
  </p>

  {
    affiliate && (
      <p class="mb-3 text-xs leading-relaxed text-ink-soft/65">
        This article contains affiliate links. If you sign up through one, we
        may earn a commission at no extra cost to you. This never changes what
        we write.
      </p>
    )
  }

  <p class="text-xs leading-relaxed text-ink-soft/65">
    This article is general information, not financial, legal, or tax advice.
    Requirements and figures change; confirm the current rules with the
    official sources above before making decisions.
  </p>
</section>
