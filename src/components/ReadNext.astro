---
/**
 * One next guide, and the question it answers.
 *
 * What this replaces: five same-category guides, ordered by when they were
 * last edited, under the heading "Related guides". That list is not a
 * recommendation — nothing in it says which one to read or why — and five
 * equal options is the arrangement people click least.
 *
 * Two things here are taken rather than written, which is the whole design:
 *
 * - The target is the first guide this article links to in its own body. The
 *   author already decided that relationship while writing the sentence
 *   around the link; deriving it from the body means the recommendation
 *   cannot drift from the argument.
 * - The hook is the target's own first FAQ question. It is a real question,
 *   already published, that the target actually answers — so the reader is
 *   handed the next question instead of a teaser written to withhold an
 *   answer. 112 of 113 guides carry an faq, and 111 carry a body link.
 *
 * Falls back to the most recently updated guide in the same category when a
 * post has no usable body link, and renders nothing at all if even that is
 * empty. The paired guide is excluded: PairedGuide already shows it above.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import { getCategory } from '../lib/categories';

interface Props {
  post: CollectionEntry<'posts'>;
  /** Slug already shown by PairedGuide, so it is not offered twice. */
  pairedWith?: string;
}

const { post, pairedWith } = Astro.props;

const live = await getCollection('posts', (p) => !p.data.draft);
const byId = new Map(live.map((p) => [p.id, p]));

const skip = new Set([post.id, ...(pairedWith ? [pairedWith] : [])]);

/**
 * Every guide this article links to in its body, scored.
 *
 * The first link is the wrong choice: it is often an aside in the opening
 * paragraph, which sent the savings-bank guide to a question about car rental
 * and pushed three unrelated guides onto the same loans article. Two signals
 * fix it. A guide linked several times is load-bearing in the argument rather
 * than mentioned in passing, and a guide in the same category is the one the
 * reader is still inside. Position only breaks ties.
 *
 * Body links are written as /category/slug/ — the last segment is the id.
 */
const scored = new Map<string, { count: number; first: number }>();
let seen = 0;
for (const m of (post.body ?? '').matchAll(
  /\]\(\/[a-z-]+\/([a-z0-9-]+)\/[^)]*\)/g,
)) {
  const id = m[1];
  seen += 1;
  if (skip.has(id) || !byId.has(id)) continue;
  const prev = scored.get(id);
  if (prev) prev.count += 1;
  else scored.set(id, { count: 1, first: seen });
}

const ranked = [...scored.entries()]
  .map(([id, s]) => ({
    post: byId.get(id)!,
    weight:
      s.count + (byId.get(id)!.data.category === post.data.category ? 2 : 0),
    first: s.first,
  }))
  .sort((a, b) => b.weight - a.weight || a.first - b.first);

let target: CollectionEntry<'posts'> | undefined = ranked[0]?.post;

if (!target) {
  target = live
    .filter((p) => p.data.category === post.data.category && !skip.has(p.id))
    .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf())[0];
}

const targetCategory = target ? getCategory(target.data.category) : undefined;
const question = target?.data.faq?.[0]?.question;
---

{
  target && targetCategory && (
    <aside class="mt-12">
      <a
        href={`/${targetCategory.slug}/${target.id}/`}
        class="group block rounded-2xl border border-rule bg-paper p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-gold/50 hover:shadow-lg hover:shadow-amber-100/50 sm:p-7"
      >
        <p class="mb-3 font-mono text-[0.65rem] tracking-[0.16em] text-ink-soft/55 uppercase">
          The next question
        </p>
        <p class="mb-3 font-display text-[1.3rem] leading-snug font-semibold text-ink group-hover:text-gold sm:text-[1.45rem]">
          {question ?? target.data.title}
        </p>
        <p class="mb-4 max-w-2xl text-[0.95rem] leading-relaxed text-ink-soft/85">
          {target.data.description}
        </p>
        <p class="flex items-center gap-2 font-sans text-[0.85rem] font-semibold text-ink group-hover:text-gold">
          {question ? target.data.title : `Read the ${targetCategory.shortTitle.toLowerCase()} guide`}
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </p>
      </a>
    </aside>
  )
}
