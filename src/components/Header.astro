---
import { CATEGORIES } from '../lib/categories';
import { SITE_TITLE } from '../lib/site';
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4">
    <a href="/" class="text-xl font-bold tracking-tight text-slate-900">
      {SITE_TITLE}<span class="text-sky-700">.com</span>
    </a>
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium text-slate-600">
      {
        CATEGORIES.map((c) => (
          <a href={`/${c.slug}/`} class="hover:text-slate-900">
            {c.shortTitle}
          </a>
        ))
      }
      <a href="/tools/" class="rounded-md bg-slate-900 px-3 py-1.5 text-white hover:bg-slate-700">
        Calculators
      </a>
    </nav>
  </div>
</header>
