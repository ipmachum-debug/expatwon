---
import { CATEGORIES } from '../lib/categories';

const current = Astro.url.pathname;
const isActive = (path: string) => current === path || current.startsWith(`${path}`);
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-ink font-display text-lg font-bold text-white shadow-sm transition-transform group-hover:-rotate-3"
        >₩</span
      >
      <span class="font-display text-[1.35rem] leading-none font-bold tracking-tight text-ink">
        ExpatWon
      </span>
    </a>
    <nav class="flex flex-wrap items-center gap-x-1 gap-y-1 text-[0.9rem] font-medium">
      {
        CATEGORIES.map((c) => (
          <a
            href={`/${c.slug}/`}
            class:list={[
              'rounded-full px-3 py-1.5 transition-colors',
              isActive(`/${c.slug}/`)
                ? 'bg-slate-100 text-ink'
                : 'text-slate-500 hover:bg-slate-50 hover:text-ink',
            ]}
          >
            {c.shortTitle}
          </a>
        ))
      }
      <a
        href="/tools/"
        class="ml-2 flex items-center gap-1.5 rounded-full bg-ink px-4 py-1.5 text-white shadow-sm transition-all hover:bg-ink-soft hover:shadow"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-3.5 w-3.5">
          <rect x="4" y="2.5" width="16" height="19" rx="2" />
          <path d="M8 7h8M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01M8.5 15h.01M12 15h.01M15.5 15h.01M8.5 18.5h.01M12 18.5h.01M15.5 18.5h.01" />
        </svg>
        Calculators
      </a>
    </nav>
  </div>
</header>
