---
import { getCollection } from 'astro:content';

import AdSlot from '../../components/AdSlot.astro';
import PostCard from '../../components/PostCard.astro';
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, getCategory } from '../../lib/categories';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const meta = getCategory(category);

const posts = (
  await getCollection('posts', (p) => p.data.category === category && !p.data.draft)
).sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
---

<Layout title={meta.title} description={meta.description}>
  <header class="mb-8">
    <h1 class="mb-2 text-3xl font-bold text-slate-900">{meta.title}</h1>
    <p class="max-w-2xl text-slate-600">{meta.description}</p>
  </header>

  <AdSlot position="top" />

  {
    posts.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="text-slate-500">Guides for this topic are on the way.</p>
    )
  }
</Layout>
