---
import { getCollection } from 'astro:content';

import AdSlot from '../../components/AdSlot.astro';
import PostCard from '../../components/PostCard.astro';
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, getCategory } from '../../lib/categories';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const meta = getCategory(category);

const posts = (
  await getCollection('posts', (p) => p.data.category === category && !p.data.draft)
).sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
---

<Layout title={meta.title} description={meta.description}>
  <header class="mb-10 flex items-start gap-5">
    <span class={`hidden h-14 w-14 shrink-0 items-center justify-center rounded-2xl sm:flex ${meta.tile}`}>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-7 w-7"
        set:html={meta.icon}
      />
    </span>
    <div>
      <nav class="mb-1 text-sm text-slate-400">
        <a href="/" class="hover:text-ink">Home</a>
        <span class="mx-1.5">/</span>
        <span class="text-slate-500">{meta.shortTitle}</span>
      </nav>
      <h1 class="mb-2 font-display text-4xl font-bold text-ink">{meta.title}</h1>
      <p class="max-w-2xl text-slate-500">{meta.description}</p>
    </div>
  </header>

  <AdSlot position="top" />

  {
    posts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="rounded-2xl border border-dashed border-slate-200 p-10 text-center text-slate-400">
        Guides for this topic are on the way.
      </p>
    )
  }
</Layout>
