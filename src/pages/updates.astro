---
import { getCollection } from 'astro:content';

import FormattedDate from '../components/FormattedDate.astro';
import Layout from '../layouts/Layout.astro';
import { OBSERVATIONS, hasHistory } from '../data/observations';
import { getCategory } from '../lib/categories';

const posts = await getCollection('posts', (p) => !p.data.draft);

// Flatten every revision across every guide into one timeline.
const entries = posts
  .flatMap((post) =>
    (post.data.revisions ?? []).map((r) => ({
      ...r,
      post,
      category: getCategory(post.data.category),
      isPublication: r.change.toLowerCase() === 'published',
    })),
  )
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const substantive = entries.filter((e) => !e.isPublication);

// Group by month for readable scanning.
const byMonth = new Map<string, typeof entries>();
for (const e of entries) {
  const key = `${e.date.getUTCFullYear()}-${String(e.date.getUTCMonth() + 1).padStart(2, '0')}`;
  if (!byMonth.has(key)) byMonth.set(key, []);
  byMonth.get(key)!.push(e);
}
const months = [...byMonth.entries()].map(([key, items]) => ({
  key,
  label: new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }),
  items,
}));

const lastChange = entries[0]?.date;

// The revision log starts when the site does, so it is short by construction.
// The compiled history behind each figure is a different and much longer
// thing, and it belongs one click away rather than merged in here — merging
// would make the count look bigger than the site's actual watching record.
const trackedCount = OBSERVATIONS.length;
const trackedMoves = OBSERVATIONS.reduce(
  (n, s) => n + (hasHistory(s) ? s.history.length - 1 : 0),
  0,
);
---

<Layout
  title="Updates & Revisions"
  description="Every correction and figure change across ExpatWon, logged with dates and sources — so you can see exactly what changed in each guide and when."
>
  <div class="mx-auto max-w-4xl">
    <header class="mb-10">
      <h1 class="mb-3 font-display text-[2.5rem] leading-tight font-bold text-ink sm:text-[2.9rem]">
        Updates &amp; revisions
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-ink-soft/85">
        Korean financial rules move. When a rate, a cap or a rule changes, we
        update the guide and log it here rather than silently overwriting the
        old figure — so you can always see what changed, when, and on whose
        authority.
      </p>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft/80">
        This log begins when the site does, so it is short on purpose. The
        longer record — what each figure was before we started watching, and
        every time it has moved since 2012 — is kept separately under{' '}
        <a class="underline decoration-rule underline-offset-4 hover:decoration-ink-soft" href="/tracked/">
          figures we track
        </a>: {trackedCount} rates and thresholds carrying {trackedMoves} recorded
        changes between them.
      </p>
    </header>

    <div class="mb-10 flex flex-wrap gap-3">
      <div class="min-w-[150px] flex-1 rounded-xl border border-rule bg-white px-4 py-3">
        <div class="text-[0.68rem] font-semibold tracking-wider text-ink-soft/65 uppercase">
          Guides maintained
        </div>
        <div class="mt-0.5 text-[0.95rem] font-semibold text-ink">{posts.length}</div>
      </div>
      <div class="min-w-[150px] flex-1 rounded-xl border border-rule bg-white px-4 py-3">
        <div class="text-[0.68rem] font-semibold tracking-wider text-ink-soft/65 uppercase">
          Logged revisions
        </div>
        <div class="mt-0.5 text-[0.95rem] font-semibold text-ink">{substantive.length}</div>
      </div>
      <div class="min-w-[150px] flex-1 rounded-xl border border-rule bg-white px-4 py-3">
        <div class="text-[0.68rem] font-semibold tracking-wider text-ink-soft/65 uppercase">
          Re-check cycle
        </div>
        <div class="mt-0.5 text-[0.95rem] font-semibold text-ink">Every 6 months</div>
      </div>
      <a
        href="/tracked/"
        class="min-w-[150px] flex-1 rounded-xl border border-rule bg-white px-4 py-3 transition-colors hover:border-ink-soft/40 hover:bg-paper"
      >
        <div class="text-[0.68rem] font-semibold tracking-wider text-ink-soft/65 uppercase">
          Figures tracked
        </div>
        <div class="mt-0.5 text-[0.95rem] font-semibold text-ink">{trackedCount}</div>
      </a>
      {
        lastChange && (
          <div class="min-w-[150px] flex-1 rounded-xl border border-rule bg-white px-4 py-3">
            <div class="text-[0.68rem] font-semibold tracking-wider text-ink-soft/65 uppercase">
              Last change
            </div>
            <div class="mt-0.5 text-[0.95rem] font-semibold text-ink">
              <FormattedDate date={lastChange} />
            </div>
          </div>
        )
      }
    </div>

    {
      months.map((month) => (
        <section class="mb-10">
          <h2 class="mb-4 border-b border-rule pb-2 font-display text-xl font-semibold text-ink">
            {month.label}
          </h2>
          <ol class="space-y-3">
            {month.items.map((e) => (
              <li class="flex flex-col gap-1 rounded-xl border border-rule px-4 py-3 sm:flex-row sm:items-baseline sm:gap-4">
                <span class="flex-none text-xs whitespace-nowrap text-ink-soft/65 sm:w-24">
                  <FormattedDate date={e.date} />
                </span>
                <span class="min-w-0 flex-1">
                  <a
                    href={`/${e.category.slug}/${e.post.id}/`}
                    class="block font-semibold text-ink hover:text-gold"
                  >
                    {e.post.data.title}
                  </a>
                  <span class="mt-0.5 block text-[0.9rem] leading-relaxed text-ink-soft/85">
                    {e.isPublication ? 'First published.' : e.change}
                    {e.source && (
                      <a
                        href={e.source}
                        rel="noopener nofollow"
                        target="_blank"
                        class="ml-1.5 text-blue-500 underline decoration-blue-200 underline-offset-2 hover:decoration-blue-400"
                      >
                        source
                      </a>
                    )}
                  </span>
                </span>
                <span
                  class={`w-fit flex-none rounded-full px-2.5 py-0.5 text-[0.68rem] font-semibold tracking-wider uppercase ${
                    e.isPublication ? 'bg-paper-deep text-ink-soft/85' : e.category.chip
                  }`}
                >
                  {e.isPublication ? 'New' : 'Revised'}
                </span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Layout>
