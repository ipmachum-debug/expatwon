---
import { getCollection } from 'astro:content';

import FormattedDate from '../components/FormattedDate.astro';
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../lib/categories';

const posts = await getCollection('posts', (p) => !p.data.draft);

const groups = CATEGORIES.map((category) => ({
  category,
  posts: posts
    .filter((p) => p.data.category === category.slug)
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
})).filter((g) => g.posts.length > 0);

const lastUpdated = posts
  .map((p) => p.data.updatedDate)
  .sort((a, b) => b.valueOf() - a.valueOf())[0];
---

<Layout
  title="All Guides"
  description="Every ExpatWon guide in one place — banking, loans, cars, business, insurance and cost of living in Korea, grouped by topic with last-verified dates."
>
  <div class="mx-auto max-w-4xl">
    <header class="mb-10">
      <h1 class="mb-3 font-display text-[2.5rem] leading-tight font-bold text-ink sm:text-[2.9rem]">
        All guides
      </h1>
      <p class="text-lg leading-relaxed text-slate-500">
        Every guide on ExpatWon, grouped by topic. {posts.length} in total —
        each one sourced from the institutions that publish the rules, and
        dated so you can see when it was last checked.
      </p>
      <p class="mt-3 text-sm text-slate-400">
        Library last updated <FormattedDate date={lastUpdated} />
      </p>
    </header>

    <nav class="mb-12 flex flex-wrap gap-2" aria-label="Jump to topic">
      {
        groups.map((g) => (
          <a
            href={`#${g.category.slug}`}
            class="rounded-full border border-slate-200 px-3.5 py-1.5 text-[0.85rem] font-medium text-slate-500 transition-colors hover:border-slate-300 hover:text-ink"
          >
            {g.category.shortTitle}
            <span class="ml-1.5 text-slate-300">{g.posts.length}</span>
          </a>
        ))
      }
    </nav>

    {
      groups.map((g) => (
        <section id={g.category.slug} class="mb-14 scroll-mt-24">
          <div class="mb-5 flex items-center gap-3 border-b border-slate-200 pb-3">
            <span class={`flex h-9 w-9 items-center justify-center rounded-lg ${g.category.tile}`}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5"
                set:html={g.category.icon}
              />
            </span>
            <h2 class="font-display text-2xl font-semibold text-ink">
              <a href={`/${g.category.slug}/`} class="hover:text-accent-dark">
                {g.category.title}
              </a>
            </h2>
            <span class="ml-auto text-sm text-slate-400">{g.posts.length} guides</span>
          </div>

          <ol class="space-y-1">
            {g.posts.map((post) => (
              <li>
                <a
                  href={`/${g.category.slug}/${post.id}/`}
                  class="group flex flex-col gap-1 rounded-xl px-3 py-3 transition-colors hover:bg-slate-50 sm:flex-row sm:items-baseline sm:gap-4"
                >
                  <span class="flex-1">
                    <span class="block font-semibold text-ink group-hover:text-accent-dark">
                      {post.data.title}
                    </span>
                    <span class="mt-0.5 block text-sm leading-relaxed text-slate-500">
                      {post.data.description}
                    </span>
                  </span>
                  <span class="flex-none text-xs whitespace-nowrap text-slate-400">
                    <FormattedDate date={post.data.updatedDate} />
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Layout>
