---
import { getCollection } from 'astro:content';

import LeadCard from '../components/LeadCard.astro';
import PostCard from '../components/PostCard.astro';
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../lib/categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../lib/site';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf(),
);
const [lead, ...latest] = posts.slice(0, 5);

const tools = [
  {
    href: '/tools/car-lease-calculator/',
    title: 'Car Lease Cost',
    description: 'The real total of a Korean car lease — return vs. buyout.',
    icon: '<path d="M5 13 6.5 8a2 2 0 0 1 1.9-1.4h7.2A2 2 0 0 1 17.5 8L19 13m-14 0h14m-14 0a2 2 0 0 0-2 2v3h2m14-5a2 2 0 0 1 2 2v3h-2m-14 0v2h3v-2m11 0v2h3v-2m-14 0h11M7.5 15.5h.01M16.5 15.5h.01"/>',
  },
  {
    href: '/tools/loan-calculator/',
    title: 'Loan Interest',
    description: 'Monthly payment, total interest, and the cost of +1%p.',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h3.75a1.75 1.75 0 1 1 0 3.5H9.5h4a1.75 1.75 0 1 1 0 3.5H9"/>',
  },
  {
    href: '/tools/cost-of-living-calculator/',
    title: 'Cost of Living',
    description: 'Your monthly budget in Korea, converted to USD.',
    icon: '<path d="M3 11 12 4l9 7M5.5 9.5V20h13V9.5M9.5 20v-6h5v6"/>',
  },
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section class="relative mb-16 border-y-2 border-ink py-14 sm:py-20">
    <div
      class="pointer-events-none absolute top-4 right-2 hidden max-w-[15rem] -rotate-[5deg] bg-[#ffe9b8] px-4 py-3 shadow-[2px_3px_0_rgba(34,28,20,0.10)] lg:block"
      aria-hidden="true"
    >
      <p class="font-hand text-[1.35rem] leading-[1.25] text-[#5c4a1e]">
        every figure links to the<br />.go.kr page that proves it
      </p>
    </div>

    <p class="mb-6 font-sans text-[0.68rem] font-bold tracking-[0.2em] text-ink-soft/70 uppercase">
      Money in Korea · In English
    </p>

    <h1 class="mb-7 max-w-[13ch] font-display text-[2.9rem] leading-[1.04] font-bold text-ink sm:text-[4.2rem]">
      Korean money,<br />with the <span class="relative inline-block">receipts<svg
          viewBox="0 0 240 16"
          preserveAspectRatio="none"
          class="absolute -bottom-1.5 left-0 h-3.5 w-full text-gold"
          aria-hidden="true"
        ><path d="M3 11C60 3 150 15 237 5" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" /></svg></span>.
    </h1>

    <p class="mb-9 max-w-xl text-[1.15rem] leading-relaxed text-ink-soft">
      Bank accounts, loans, cars, business registration, and the real cost of
      living — written by someone who has run a Korean company for ten years and
      files the same paperwork you are about to.
    </p>

    <div class="mb-11 flex flex-wrap items-center gap-3">
      <a
        href="/tools/"
        class="rounded-full bg-ink px-6 py-3 font-sans text-[0.92rem] font-semibold text-paper transition-transform hover:-translate-y-0.5"
      >
        Run your own numbers →
      </a>
      <a
        href="/banking/"
        class="rounded-full border border-ink/25 px-6 py-3 font-sans text-[0.92rem] font-semibold text-ink transition-colors hover:border-ink"
      >
        Start with banking
      </a>
    </div>

    <dl class="flex flex-wrap gap-x-12 gap-y-5 border-t-2 border-ink pt-5">
      <div>
        <dt class="num text-[2rem] leading-none font-bold text-ink">{posts.length}</dt>
        <dd class="mt-1.5 font-sans text-[0.64rem] font-bold tracking-[0.14em] text-ink-soft/70 uppercase">Guides, all sourced</dd>
      </div>
      <div>
        <dt class="num text-[2rem] leading-none font-bold text-ink">6mo</dt>
        <dd class="mt-1.5 font-sans text-[0.64rem] font-bold tracking-[0.14em] text-ink-soft/70 uppercase">Re-check cycle</dd>
      </div>
      <div>
        <dt class="num text-[2rem] leading-none font-bold text-ink">2016</dt>
        <dd class="mt-1.5 font-sans text-[0.64rem] font-bold tracking-[0.14em] text-ink-soft/70 uppercase">Running a Korean company since</dd>
      </div>
    </dl>
  </section>

  <!-- Latest guides -->
  <section class="mb-16">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 class="font-display text-3xl font-bold text-ink">Latest guides</h2>
      <a
        href="/articles/"
        class="flex-none text-sm font-medium text-ink underline decoration-gold decoration-2 underline-offset-4 transition-colors hover:text-gold"
      >
        View all {posts.length} guides →
      </a>
    </div>
    <LeadCard post={lead} />
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- Categories -->
  <section class="mb-16">
    <h2 class="mb-6 font-display text-3xl font-bold text-ink">Browse by topic</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        CATEGORIES.map((c) => (
          <a
            href={`/${c.slug}/`}
            class="group rounded-2xl border border-rule bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-ink/35 hover:shadow-lg hover:shadow-slate-200/60"
          >
            <span class={`mb-4 flex h-11 w-11 items-center justify-center rounded-xl ${c.tile}`}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
                set:html={c.icon}
              />
            </span>
            <h3 class="mb-1.5 font-display text-xl font-semibold text-ink group-hover:text-gold">
              {c.title}
            </h3>
            <p class="text-sm leading-relaxed text-ink-soft/85">{c.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Calculators -->
  <section class="rounded-3xl bg-paper p-8 sm:p-10">
    <div class="mb-6 max-w-xl">
      <h2 class="mb-2 font-display text-3xl font-bold text-ink">Run your own numbers</h2>
      <p class="text-ink-soft/85">
        Free calculators built for the money decisions expats actually face in
        Korea. Everything runs in your browser.
      </p>
    </div>
    <div class="grid gap-5 sm:grid-cols-3">
      {
        tools.map((t) => (
          <a
            href={t.href}
            class="group rounded-2xl border border-rule bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-100/60"
          >
            <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-paper-deep text-gold">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
                set:html={t.icon}
              />
            </span>
            <h3 class="mb-1.5 font-semibold text-ink group-hover:text-gold">{t.title} Calculator</h3>
            <p class="text-sm leading-relaxed text-ink-soft/85">{t.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
