---
import { getCollection } from 'astro:content';

import LeadCard from '../components/LeadCard.astro';
import PostCard from '../components/PostCard.astro';
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../lib/categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../lib/site';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf(),
);
const [lead, ...latest] = posts.slice(0, 5);

const tools = [
  {
    href: '/tools/car-lease-calculator/',
    title: 'Car Lease Cost',
    description: 'The real total of a Korean car lease — return vs. buyout.',
    icon: '<path d="M5 13 6.5 8a2 2 0 0 1 1.9-1.4h7.2A2 2 0 0 1 17.5 8L19 13m-14 0h14m-14 0a2 2 0 0 0-2 2v3h2m14-5a2 2 0 0 1 2 2v3h-2m-14 0v2h3v-2m11 0v2h3v-2m-14 0h11M7.5 15.5h.01M16.5 15.5h.01"/>',
  },
  {
    href: '/tools/loan-calculator/',
    title: 'Loan Interest',
    description: 'Monthly payment, total interest, and the cost of +1%p.',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h3.75a1.75 1.75 0 1 1 0 3.5H9.5h4a1.75 1.75 0 1 1 0 3.5H9"/>',
  },
  {
    href: '/tools/cost-of-living-calculator/',
    title: 'Cost of Living',
    description: 'Your monthly budget in Korea, converted to USD.',
    icon: '<path d="M3 11 12 4l9 7M5.5 9.5V20h13V9.5M9.5 20v-6h5v6"/>',
  },
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section class="relative mb-16 overflow-hidden rounded-3xl bg-ink px-6 py-16 text-white sm:px-12 sm:py-20">
    <div class="pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-blue-500/25 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-sky-500/15 blur-3xl" aria-hidden="true"></div>
    <span
      class="pointer-events-none absolute -right-6 -bottom-24 font-display text-[17rem] leading-none font-bold text-white/[0.045] select-none"
      aria-hidden="true">₩</span
    >

    <div class="relative max-w-2xl">
      <p class="mb-4 text-xs font-semibold tracking-[0.2em] text-blue-400 uppercase">
        Money in Korea · In English
      </p>
      <h1 class="mb-5 font-display text-4xl leading-[1.12] font-bold sm:text-[3.4rem]">
        Korean money,<br />without the guesswork.
      </h1>
      <p class="mb-8 max-w-xl text-lg leading-relaxed text-slate-300">
        Bank accounts, loans, cars, business registration, and the real cost of
        living — how it works, what it costs, and which official rules apply to
        foreigners.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/tools/"
          class="rounded-full bg-blue-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-500/25 transition-all hover:bg-blue-400 hover:shadow-blue-400/30"
        >
          Try the calculators →
        </a>
        <a
          href="/banking/"
          class="rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/50 hover:bg-white/5"
        >
          Start with banking
        </a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-[0.8rem] text-slate-400">
        <li class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span> Official sources only
        </li>
        <li class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span> Last-verified dates on every guide
        </li>
        <li class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span> Written from first-hand experience
        </li>
      </ul>
    </div>
  </section>

  <!-- Latest guides -->
  <section class="mb-16">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 class="font-display text-3xl font-bold text-ink">Latest guides</h2>
      <a
        href="/articles/"
        class="flex-none text-sm font-medium text-accent-dark transition-colors hover:text-accent"
      >
        View all {posts.length} guides →
      </a>
    </div>
    <LeadCard post={lead} />
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- Categories -->
  <section class="mb-16">
    <h2 class="mb-6 font-display text-3xl font-bold text-ink">Browse by topic</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        CATEGORIES.map((c) => (
          <a
            href={`/${c.slug}/`}
            class="group rounded-2xl border border-slate-200 bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-lg hover:shadow-slate-200/60"
          >
            <span class={`mb-4 flex h-11 w-11 items-center justify-center rounded-xl ${c.tile}`}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
                set:html={c.icon}
              />
            </span>
            <h3 class="mb-1.5 font-display text-xl font-semibold text-ink group-hover:text-accent-dark">
              {c.title}
            </h3>
            <p class="text-sm leading-relaxed text-slate-500">{c.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Calculators -->
  <section class="rounded-3xl bg-paper p-8 sm:p-10">
    <div class="mb-6 max-w-xl">
      <h2 class="mb-2 font-display text-3xl font-bold text-ink">Run your own numbers</h2>
      <p class="text-slate-500">
        Free calculators built for the money decisions expats actually face in
        Korea. Everything runs in your browser.
      </p>
    </div>
    <div class="grid gap-5 sm:grid-cols-3">
      {
        tools.map((t) => (
          <a
            href={t.href}
            class="group rounded-2xl border border-slate-200 bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-100/60"
          >
            <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent-dark">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
                set:html={t.icon}
              />
            </span>
            <h3 class="mb-1.5 font-semibold text-ink group-hover:text-accent-dark">{t.title} Calculator</h3>
            <p class="text-sm leading-relaxed text-slate-500">{t.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
