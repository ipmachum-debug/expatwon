---
import Layout from '../../layouts/Layout.astro';

const tools = [
  {
    href: '/tools/car-lease-calculator/',
    title: 'Korea Car Lease Cost Calculator',
    description:
      'Down payment, deposit, monthly payments, and residual value → the real total cost of leasing, with and without buyout.',
    icon: '<path d="M5 13 6.5 8a2 2 0 0 1 1.9-1.4h7.2A2 2 0 0 1 17.5 8L19 13m-14 0h14m-14 0a2 2 0 0 0-2 2v3h2m14-5a2 2 0 0 1 2 2v3h-2m-14 0v2h3v-2m11 0v2h3v-2m-14 0h11M7.5 15.5h.01M16.5 15.5h.01"/>',
  },
  {
    href: '/tools/loan-calculator/',
    title: 'Korea Loan Interest Calculator',
    description:
      'Principal, rate, and term → monthly payment and total interest, plus what a 1%p higher rate would cost you.',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h3.75a1.75 1.75 0 1 1 0 3.5H9.5h4a1.75 1.75 0 1 1 0 3.5H9"/>',
  },
  {
    href: '/tools/cost-of-living-calculator/',
    title: 'Korea Cost of Living Calculator',
    description:
      'Rent, phone, food, and transport → your estimated monthly budget in KRW and USD.',
    icon: '<path d="M3 11 12 4l9 7M5.5 9.5V20h13V9.5M9.5 20v-6h5v6"/>',
  },
];
---

<Layout
  title="Korea Money Calculators"
  description="Free calculators for expats in Korea: car lease total cost, loan interest, and monthly cost of living with USD conversion."
>
  <header class="mb-10">
    <h1 class="mb-3 font-display text-4xl font-bold text-ink">Calculators</h1>
    <p class="max-w-2xl text-ink-soft/85">
      Quick tools for the money decisions expats actually face in Korea. All
      calculations run in your browser — nothing is stored or sent anywhere.
    </p>
  </header>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      tools.map((t) => (
        <a
          href={t.href}
          class="group rounded-2xl border border-rule bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-100/60"
        >
          <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-paper-deep text-gold">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              set:html={t.icon}
            />
          </span>
          <h2 class="mb-1.5 font-display text-xl font-semibold text-ink group-hover:text-gold">
            {t.title}
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft/85">{t.description}</p>
        </a>
      ))
    }
  </div>
</Layout>
