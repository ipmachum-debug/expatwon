---
import AdSlot from '../../components/AdSlot.astro';
import BuyVsRentCalculator from '../../components/calculators/BuyVsRentCalculator.tsx';
import RelatedPosts from '../../components/RelatedPosts.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Buy vs Rent Calculator — Korea"
  description="Break-even holding period for buying versus jeonse or wolse in Korea, with the opportunity cost of tied-up equity charged symmetrically to both sides."
>
  <header class="mb-8">
    <h1 class="mb-3 font-display text-4xl font-bold text-ink">
      Buy vs Rent Calculator
    </h1>
    <p class="max-w-2xl text-slate-600">
      The usual comparison — monthly rent against a mortgage payment — is not a
      comparison at all. Loan principal is not a cost, and a jeonse deposit is
      not free because you get it back. This calculator charges the
      <strong>same opportunity cost</strong> to equity tied up in a purchase and
      to equity tied up in a deposit, then finds the first year at which owning
      becomes the cheaper use of that capital.
    </p>
  </header>

  <BuyVsRentCalculator client:visible />

  <AdSlot position="bottom" />

  <RelatedPosts category="cost-of-living" heading="Housing costs in Korea" />
</Layout>
